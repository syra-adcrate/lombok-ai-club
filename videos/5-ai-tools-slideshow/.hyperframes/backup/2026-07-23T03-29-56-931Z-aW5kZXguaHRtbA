      const tl = gsap.timeline({ paused: true });
      const EASE_IN = "power3.out";

      // ---- S1 · hook (kinetic-type: per-word stagger + underline draw) ----
      tl.fromTo("#s1-bg", { scale: 1.06, xPercent: -2 }, { scale: 1.14, xPercent: 2, duration: 3.6, ease: "none" }, 0);
      tl.from("#s1-chip", { y: -40, opacity: 0, duration: 0.5, ease: EASE_IN }, 0.15);
      tl.from("#s1-title .w", { yPercent: 110, opacity: 0, duration: 0.55, ease: "back.out(1.6)", stagger: 0.14 }, 0.35);
      tl.fromTo("#s1-underline", { scaleX: 0 }, { scaleX: 1, duration: 0.5, ease: "power4.out" }, 1.05);
      tl.from("#s1-id", { y: 46, opacity: 0, duration: 0.55, ease: EASE_IN }, 1.25);
      tl.from("#s1-en", { opacity: 0, duration: 0.45, ease: "none" }, 1.65);
      tl.from("#s1-rail i", { opacity: 0, x: -18, duration: 0.3, ease: EASE_IN, stagger: 0.06 }, 1.8);

      // ---- S2–S6 · tool cards (titlecard-reveal card chain; hard-cut seams) ----
      const slides = [
        { id: "s2", start: 3.6, dir: 1 },
        { id: "s3", start: 8.2, dir: -1 },
        { id: "s4", start: 12.8, dir: 1 },
        { id: "s5", start: 17.4, dir: -1 },
        { id: "s6", start: 22.0, dir: 1 },
      ];
      slides.forEach(({ id, start, dir }) => {
        // micro-drift on the backdrop (multi-phase-camera, micro register)
        tl.fromTo(`#${id}-bg`,
          { scale: 1.06, xPercent: 2.4 * dir },
          { scale: 1.14, xPercent: -2.4 * dir, duration: 4.6, ease: "none" }, start);
        // ghost number: soft spring settle (spring-pop-entrance, single beat)
        tl.from(`#${id}-num`, { scale: 0.82, opacity: 0, duration: 0.65, ease: "back.out(1.4)" }, start + 0.1);
        // the ONE restrained move: stack rises together, then holds
        tl.from(`#${id}-stack > *`, { y: 54, opacity: 0, duration: 0.6, ease: EASE_IN, stagger: 0.09 }, start + 0.25);
        tl.fromTo(`#${id}-rule`, { scaleX: 0 }, { scaleX: 1, duration: 0.45, ease: "power4.out" }, start + 0.6);
      });

      // ---- S7 · CTA (kinetic-type CTA: value line → lockup spring-pop → long hold) ----
